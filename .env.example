# Browser origin, no trailing path. Use the exact external hostname + port.
PUBLIC_URL=http://localhost:8091
PORT=8091
# Blank: server generates a setup token and prints it while no user exists.
SETUP_TOKEN=
# Optional here; credentials can be entered in Settings after admin setup.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Blank: created once in DATA_DIR/master.key. Back this file up separately.
MASTER_KEY=
PART_SIZE_MIB=256
MAX_UPLOAD_GIB=50
MAX_PARALLEL_UPLOADS=2
MAX_PARALLEL_DOWNLOADS=2
MEMORY_CACHE_MIB=64
TDLIB_CACHE_MIB=1024
RUST_LOG=itclub_cloud=info
# Docker TDLib source: replace master with a reviewed commit for reproducibility.
TDLIB_REF=master
BUILD_JOBS=2
# For non-Docker deployment (defaults assume cwd = backend):
# BIND=0.0.0.0:8091
# DATA_DIR=./data
# FRONTEND_DIR=../frontend/dist
# TDLIB_PATH=/absolute/path/libtdjson.so
# FFMPEG_PATH=ffmpeg
# YTDLP_PATH=yt-dlp
# ARIA2_PATH=aria2c

# Existing Docker installation: set the exact old volume name before upgrading.
CLOUD_DATA_VOLUME=itclub_cloud_data

# Shared SSD budget for DATA_DIR/temp + DATA_DIR/archives (GiB; 0 disables this cap).
SSD_TEMP_LIMIT_GIB=20
# Minimum filesystem space to keep available (GiB).
SSD_MIN_FREE_GIB=2
